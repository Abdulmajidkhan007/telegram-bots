# --- Telegram ---
TELEGRAM_BOT_TOKEN=BU_YERGA_YOZING
# Mahsulot postlari turgan kanal (forward uchun). Bo'sh qolsa forward o'chadi.
TELEGRAM_CHANNEL_ID=@kanal_username
# Buyurtmalar tushadigan admin guruhi ID si. Bo'sh qolsa lid guruhga ketmaydi.
ADMIN_GROUP_ID=

# --- AI ---
GEMINI_API_KEY=BU_YERGA_YOZING
# Model nomini o'zgartirishdan oldin mavjudligiga ishonch hosil qiling —
# bot startda tekshiradi va noto'g'ri bo'lsa ishga tushmaydi.
GEMINI_MODEL=gemini-2.5-flash
# Ko'p tilli embedding: katalog o'zbekcha, inglizcha model tushunmaydi.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Vektor baza ---
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=atoyo_products
# Qidiruv balli shundan past bo'lsa — "topilmadi" deb hisoblanadi (0.0 - 1.0).
RELEVANCE_THRESHOLD=0.35

# --- Firestore (faqat o'qish uchun) ---
FIREBASE_CREDENTIALS=serviceAccountKey.json

# --- Integratsiya ---
# n8n webhook. Bo'sh qolsa lid faqat admin guruhiga boradi.
N8N_WEBHOOK_URL=

# --- Cheklovlar ---
RATE_LIMIT_PER_MINUTE=8
HISTORY_DB=history.db
