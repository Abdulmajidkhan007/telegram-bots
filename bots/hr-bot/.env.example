# @BotFather'dan olingan token (bot: @hr_ai_007_bot)
BOT_TOKEN=BU_YERGA_YOZING

# Platforma adminlari (vergul bilan). Kompaniyalarni faollashtiradi/bloklaydi.
ADMIN_IDS=

# SQLite fayli turadigan papka. Bo'sh — bot papkasi. Railway/Docker: /data (Volume).
DATA_DIR=

# Baza. Bo'sh — DATA_DIR/hr_bot.db (SQLite).
# PostgreSQL'ga o'tish: postgresql+asyncpg://user:pass@host/db (asyncpg o'rnatiladi)
DATABASE_URL=

# Gemini — CV'ni vakansiya talablari bilan solishtirish uchun (AI Studio).
# Bo'sh bo'lsa bot ishlaydi, faqat AI ball "hisoblanmadi" bo'ladi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kuniga nechta AI baholash (xarajat nazorati). 0 — AI o'chiq.
AI_DAILY_LIMIT=200

# Vakansiya yopilgandan keyin necha kunda CV matni va fayli o'chiriladi.
CV_RETENTION_DAYS=30

# --- To'lov (4-faza). Bo'sh/0 — o'sha usul o'chiq; ikkalasi o'chiq — faqat pilot
# (kompaniyani admin qo'lda faollashtiradi). Narx va karta raqami FAQAT env'da.

# Telegram Stars: 30 kunlik obuna narxi (1..10000 Stars — Bot API cheklovi).
STARS_PRICE=

# Karta + chek (zaxira): 30 kun uchun narx so'mda va karta raqami.
CARD_PRICE_UZS=
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_HOLDER=

# Obuna tugashidan necha kun oldin egaga eslatma.
EXPIRY_REMIND_DAYS=3

# --- Telegram Business (5-faza): HR chatida bitta nomzodga necha soatda bir marta
# vakansiyalar ro'yxati yuboriladi (har xabarga emas).
BUSINESS_REPLY_HOURS=24
