# @BotFather'dan olingan token (bot: @hr_ai_007_bot)
BOT_TOKEN=BU_YERGA_YOZING

# Platforma adminlari (vergul bilan). Kompaniyalarni faollashtiradi/bloklaydi.
ADMIN_IDS=

# Baza. Bo'sh — bot papkasidagi hr_bot.db (SQLite).
# PostgreSQL'ga o'tish: postgresql+asyncpg://user:pass@host/db (asyncpg o'rnatiladi)
DATABASE_URL=

# Gemini — CV'ni vakansiya talablari bilan solishtirish uchun (AI Studio).
# Bo'sh bo'lsa bot ishlaydi, faqat AI ball "hisoblanmadi" bo'ladi.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Kuniga nechta AI baholash (xarajat nazorati). 0 — AI o'chiq.
AI_DAILY_LIMIT=200

# Vakansiya yopilgandan keyin necha kunda CV matni va fayli o'chiriladi.
CV_RETENTION_DAYS=30

# 4-faza (to'lov) uchun — hozir ishlatilmaydi. Karta raqami faqat shu yerda.
PAYMENT_CARD_NUMBER=
