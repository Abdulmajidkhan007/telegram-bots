# @BotFather'dan olingan token (yangisini oling — eskisi revoke qilingan)
BOT_TOKEN=BU_YERGA_YOZING

# Bosh admin Telegram ID si (@userinfobot dan). Uni bot ichidan o'chirib
# bo'lmaydi, /backup va /restore faqat unga ishlaydi.
SUPER_ADMIN_ID=

# database.json qayerda turadi. Lokal'da bo'sh qoldiring (bot papkasi).
# Railway'da: Volume qo'shing (Mount path: /data) va DATA_DIR=/data yozing —
# aks holda har deploy'da kinolar va foydalanuvchilar o'chib ketadi.
DATA_DIR=

# Kinoni forward qilish, "Saqlash" va telefonda skrinshot olishni taqiqlash.
# true (standart) yoki false.
PROTECT_CONTENT=true

# Bir foydalanuvchiga soatiga nechta kino beriladi (adminlarga cheklov yo'q).
# Hamma kinoni ketma-ket yig'ib oladigan skriptlarni sekinlashtiradi. 0 — cheklovsiz.
MOVIES_PER_HOUR=20
