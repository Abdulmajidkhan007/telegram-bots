# Telegram Bot
BOT_TOKEN=your_bot_token_here
BOT_WEBHOOK_URL=https://yourdomain.com/webhook

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/expense_tracker

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# API
API_PORT=3001
API_URL=http://localhost:3001
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Web Dashboard
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
# Telegram Login Widget: bot username (@ belgisisiz). Widget faqat BotFather'da
# /setdomain orqali web domeni ro'yxatdan o'tkazilgandan keyin ishlaydi.
# API esa kirishni BOT_TOKEN bilan tekshiradi — API servisida ham BOT_TOKEN bo'lsin.
VITE_TELEGRAM_BOT_USERNAME=your_bot_username
# Web dashboard manzili: bot sozlamalarda shu havolani tugma qilib beradi,
# API esa CORS'da shu origin'ga ruxsat beradi
WEB_URL=http://localhost:3000

# Admin
ADMIN_TELEGRAM_ID=your_admin_telegram_id

# OCR (optional)
OCR_API_KEY=your_ocr_api_key

# Ovozli xabar orqali xarajat qo'shish (ixtiyoriy) — bittasi yetarli.
# Ikkalasi bo'lsa Gemini ishlatiladi. Ikkalasi ham bo'sh bo'lsa bot ovozli
# xabarlarga javob bermaydi.
GEMINI_API_KEY=
# Ixtiyoriy, standart: gemini-2.5-flash
GEMINI_MODEL=
OPENAI_API_KEY=

# Pullik paketlar (Plus/Pro/Max) — STANDART HOLATDA HAMMASI O'CHIQ.
# Tartib: README → «Pullik paketlar». Narxlarni egasi belgilaydi — bu yerda qiymat yo'q.
# 1 bo'lsa limitlar va /tarif yoqiladi. Bo'sh/boshqa qiymat — bot avvalgidek, limit ham, DB so'rovi ham yo'q.
BILLING_ENABLED=
# Karta narxi, so'm / 30 kun (musbat butun son). Bo'sh yoki noto'g'ri bo'lsa o'sha paket sotilmaydi.
TARIF_PLUS_NARX=
TARIF_PRO_NARX=
TARIF_MAX_NARX=
# Stars narxi / 30 kun (musbat butun son, Telegram chegarasi 10000). Bo'sh bo'lsa Stars bilan sotilmaydi.
TARIF_PLUS_STARS=
TARIF_PRO_STARS=
TARIF_MAX_STARS=
# 1 bo'lsa ⭐ Stars usuli taklif qilinadi (TARIF_*_STARS ham kerak)
TOLOV_STARS=
# Karta + chek usuli (faqat Railway Variables'da; repoga yozilmaydi). Chek ADMIN_TELEGRAM_ID ga boradi.
TOLOV_KARTA=
TOLOV_KARTA_EGASI=

# Environment
NODE_ENV=development
