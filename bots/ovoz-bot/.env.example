# @BotFather'dan olingan token
BOT_TOKEN=BU_YERGA_YOZING

# Gemini API kaliti (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Ovoz → matn modeli va 429/503 bo'lsa zaxira model
GEMINI_STT_MODEL=gemini-3.8-flash
GEMINI_STT_MODEL_FALLBACK=gemini-2.5-flash

# Matn → ovoz modeli: gemini-3.8-flash-tts yoki gemini-3.8-flash-lite-tts
GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Standart ovoz (Gemini prebuilt voice nomi)
TTS_DEFAULT_VOICE=Kore

# Adminlar (vergul bilan) — kunlik limit ularga qo'llanmaydi
ADMIN_IDS=

# Har foydalanuvchiga kunlik so'rov soni (STT + TTS birga)
DAILY_LIMIT=30

# Matn → ovoz uchun maksimal belgi soni
TTS_MAX_CHARS=1000

# Limit bazasi papkasi. Bo'sh — bot papkasi. Railway: /data (Volume)
DATA_DIR=

# ffmpeg yo'li. Bo'sh — PATH'dan topiladi.
FFMPEG_PATH=
